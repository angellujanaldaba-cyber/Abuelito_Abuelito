name: Deploy approved image digests to EKS
on:
  workflow_dispatch:
    inputs:
      build_run_id:
        description: Run ID exitoso de Build versioned ARM64 images
        type: string
        required: true
      confirmation:
        description: Escribir DEPLOY seguido de espacio y el ID del build
        type: string
        required: true
permissions:
  contents: read
  actions: read
  id-token: write
concurrency:
  group: application-dev
  cancel-in-progress: false
jobs:
  deploy:
    if: github.repository == 'angellujanaldaba-cyber/Abuelito_Abuelito' && github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main'
    runs-on: [self-hosted, linux, ARM64, abuelito-dev]
    timeout-minutes: 30
    environment: dev-deploy
    env:
      GH_TOKEN: ${{ github.token }}
      GH_REPO: ${{ github.repository }}
      BUILD_RUN_ID: ${{ inputs.build_run_id }}
      CONFIRMATION: ${{ inputs.confirmation }}
    steps:
      - name: Configure temporary kubeconfig
        run: echo "KUBECONFIG=$RUNNER_TEMP/abuelito-kubeconfig" >> "$GITHUB_ENV"
      - name: Verify source build provenance
        run: |
          python3 - <<'PYCODE'
          import os, json, subprocess
          run_id = os.environ['BUILD_RUN_ID']
          if not run_id.isdigit(): raise SystemExit('Build ID invalido')
          if os.environ['CONFIRMATION'] != 'DEPLOY ' + run_id:
              raise SystemExit('Confirmacion incorrecta')
          run = json.loads(subprocess.check_output(['gh','api','repos/'+os.environ['GH_REPO']+'/actions/runs/'+run_id]))
          if (run['conclusion'] != 'success' or run['head_branch'] != 'main'
              or run['event'] != 'workflow_dispatch'
              or run['path'] != '.github/workflows/build-images.yml'):
              raise SystemExit('No es un build aprobado del workflow esperado')
          PYCODE
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
        with:
          name: release
          run-id: ${{ inputs.build_run_id }}
          github-token: ${{ github.token }}
          path: ${{ runner.temp }}/release-artifact
      - name: Read release source commit
        id: release
        run: |
          python3 - <<'PYCODE'
          import json, os, re
          from pathlib import Path
          release = json.loads((Path(os.environ['RUNNER_TEMP'])/'release-artifact/release.json').read_text())
          commit = release['source_commit']
          if not re.fullmatch(r'[a-f0-9]{40}',commit): raise SystemExit('Commit invalido')
          with open(os.environ['GITHUB_OUTPUT'],'a') as f: f.write('commit='+commit+'\n')
          PYCODE
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ steps.release.outputs.commit }}
          persist-credentials: false
      - name: Use release descriptor
        run: cp "$RUNNER_TEMP/release-artifact/release.json" release.json
      - uses: aws-actions/configure-aws-credentials@7474bc4690e29a8392af63c5b98e7449536d5c3a # v4
        with:
          role-to-assume: ${{ vars.AWS_DEPLOY_ROLE_ARN }}
          aws-region: us-east-1
          allowed-account-ids: '455982475279'
      - run: python3 deploy/scripts/deploy_release.py
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: deployed-release
          path: deployment.json
          retention-days: 90
      - name: Remove temporary access file
        if: always()
        run: |
          python3 - <<'PYCODE'
          import os
          from pathlib import Path
          Path(os.environ['KUBECONFIG']).unlink(missing_ok=True)
          PYCODE
